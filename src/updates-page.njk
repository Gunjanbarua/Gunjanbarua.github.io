---
layout: base.njk
title: Research updates
permalink: /updates/
bare: true
---
<section class="section">
  <div class="wrap">
    <div class="eyebrow">Archive</div>
    <h1 class="section-title">Research updates</h1>
    <p class="lead">News, talks, awards and publications, newest first.</p>
    <ul class="updates-list">
      {%- for item in updates %}
      <li>
        <time datetime="{{ item.date }}">{{ item.date | dateDisplay }}</time>
        <div>{{ item.title | markdownify | safe }}{% if item.description %}{{ item.description | markdownify | safe }}{% endif %}</div>
      </li>
      {%- else %}
      <li><p>No updates yet.</p></li>
      {%- endfor %}
    </ul>
    <p style="margin-top:32px"><a href="{{ '/' | url }}">← Back to home</a></p>
  </div>
</section>
