{%- from "icons.njk" import linkedin, mail -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-8M0SGYD24Z"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8M0SGYD24Z');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ site.description }}" />
  <meta name="keywords" content="{{ site.keywords }}" />
  <meta name="author" content="{{ site.author }}" />
  <meta name="google-site-verification" content="hha5XpHKSP8P3DEXtehBId6YRDICw-IlB2HCp5pqZmw" />
  <title>{% if title %}{{ title }} – {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <script>document.documentElement.classList.add('js');</script>

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.title }}" />
  <meta property="og:description" content="{{ site.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": site.author,
    "jobTitle": "Digital MRV Solutions Specialist",
    "worksFor": { "@type": "Organization", "name": "Verra" },
    "alumniOf": { "@type": "CollegeOrUniversity", "name": "Virginia Tech" },
    "url": site.url,
    "sameAs": [site.linkedin]
  } | dump | safe }}</script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

{% if bare %}
  <header class="page-head">
    <div class="wrap">
      <a class="wordmark" style="padding:0" href="{{ '/' | url }}">{{ site.author }}</a>
      <a href="{{ '/' | url }}">← Back to home</a>
    </div>
  </header>
{% else %}
  <aside class="rail">
    <a class="wordmark" href="#home">{{ site.author }}</a>
    <nav class="rail-links" aria-label="Sections">
      {%- for item in nav %}{% if not item.feature or site.features[item.feature] %}
      <a href="#{{ item.id }}" data-section="{{ item.id }}">{{ item.label }}</a>
      {%- endif %}{% endfor %}
    </nav>
    <div class="rail-icons">
      <a class="icon-link" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">{{ linkedin() }}</a>
      <a class="icon-link" href="mailto:{{ site.email }}" aria-label="Email">{{ mail() }}</a>
    </div>
  </aside>

  <header class="topbar">
    <a class="wordmark" style="padding:0" href="#home">{{ site.author }}</a>
    <button class="menu-btn" id="menu-open" aria-expanded="false" aria-controls="menu">Menu</button>
  </header>

  <div class="menu-overlay" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="menu-head">
      <span class="wordmark" style="padding:0">{{ site.author }}</span>
      <button class="menu-btn" id="menu-close">Close</button>
    </div>
    <nav aria-label="Sections (menu)">
      {%- for item in nav %}{% if not item.feature or site.features[item.feature] %}
      <a href="#{{ item.id }}">{{ item.label }}</a>
      {%- endif %}{% endfor %}
    </nav>
    <div class="rail-icons">
      <a class="icon-link" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">{{ linkedin() }}</a>
      <a class="icon-link" href="mailto:{{ site.email }}" aria-label="Email">{{ mail() }}</a>
    </div>
  </div>
{% endif %}

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© 2026 Gunjan Barua</span><span>·</span><span>Based in Pennsylvania, USA</span><span>·</span><span>Views are my own.</span>
    </div>
  </footer>

{% if not bare %}
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lb-btn lb-close" id="lb-close" aria-label="Close image">&times;</button>
    <button class="lb-btn lb-prev" id="lb-prev" aria-label="Previous image">&#8249;</button>
    <button class="lb-btn lb-next" id="lb-next" aria-label="Next image">&#8250;</button>
    <figure><img id="lb-img" src="" alt="" /><figcaption id="lb-cap"></figcaption></figure>
  </div>
{% endif %}

  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
