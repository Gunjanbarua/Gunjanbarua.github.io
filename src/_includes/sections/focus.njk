<section class="section" id="focus" aria-labelledby="focus-title">
  <div class="wrap">
    <div class="eyebrow">Focus</div>
    <h2 class="section-title" id="focus-title">Where I work</h2>
    <p class="lead">My work sits where environmental science meets software: making the data behind climate and sustainability claims measurable, verifiable and usable at scale.</p>
    <div class="grid-3">
      {%- for p in pillars %}
      <article class="card pillar reveal">
        <h3>{{ p.title }}</h3>
        <p>{{ p.description }}</p>
        <ul class="dots">
          {%- for ex in p.examples %}
          <li><a href="{{ ex.href }}"{% if ex.external %} target="_blank" rel="noopener"{% endif %}>{{ ex.label }}</a></li>
          {%- endfor %}
        </ul>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
